{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "composite": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  // scripts/ is included because tests now import a build script directly
  // (crawlableBody.mjs) rather than only reading one as text.
  "include": ["src", "tests.setup.ts", "tests", "scripts"]
}